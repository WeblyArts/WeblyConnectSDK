{
    "name": "weblyarts/connect-sdk-core",
    "description": "Framework-agnostic auth, HTTP and AgentHub client for WeblyArts Connect integrations.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "WeblyConnect\\Sdk\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WeblyConnect\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
