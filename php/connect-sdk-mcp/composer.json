{
    "name": "weblyarts/connect-sdk-mcp",
    "description": "Turns any PHP backend into an MCP tool server consumable by WeblySuite agents via federation (JSON-RPC 2.0 over HTTP, bearer token).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "WeblyConnect\\Sdk\\Mcp\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WeblyConnect\\Sdk\\Mcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
